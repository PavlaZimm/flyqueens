# Primární zdroj poloh je ADSB.lol (bez klíče, licence ODbL 1.0).
# OpenSky zapněte pouze po získání písemné licence pro provozní/komerční použití.
OPENSKY_LICENSED=false
OPENSKY_CLIENT_ID=your_client_id
OPENSKY_CLIENT_SECRET=your_client_secret

# Airplanes.live v produkci nejdřív projednejte s provozovatelem API.
AIRPLANES_LIVE_ENABLED=false

# Volitelné partnerské odkazy. Blok se zobrazí jen s platnou HTTPS adresou.
AFFILIATE_PARKING_PRG_URL=
AFFILIATE_PARKING_BRQ_URL=
AFFILIATE_PARKING_OSR_URL=

# Proxy LiveATC je výchozím stavem vypnutá. Zapněte jen s oprávněním k redistribuci.
ENABLE_ATC_PROXY=false

# AeroDataBox via API.market — přesné DEP→ARR trasy
# Registrace: https://api.market → produkt AeroDataBox
# POZOR: nikdy nepřidávat prefix NEXT_PUBLIC_ — klíč musí zůstat pouze na serveru!
AERODATABOX_API_KEY=your_api_market_key
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox

# Supabase — pro budoucí auth a oblíbené lety (zatím nepotřeba)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# OpenWeatherMap — pro vrstvu počasí na mapě (zatím nepotřeba)
# NEXT_PUBLIC_OWM_KEY=your_key_here
